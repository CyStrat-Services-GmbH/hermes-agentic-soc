{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile template",
  "type": "object",
  "required": [
    "id",
    "status",
    "description",
    "workflow"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "mvp"
      ]
    },
    "description": {
      "type": "string"
    },
    "workflow": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
